@model List<SuperBodega.Web.Modelos.Producto>

<h1 class="mb-4">
    Productos Disponibles
</h1>

<div class="row">

    @foreach (var producto in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow">

                <div class="card-body">

                    <h4>
                        @producto.Nombre
                    </h4>

                    <p>
                        @producto.Descripcion
                    </p>

                    <h5>
                        ₡ @producto.Precio
                    </h5>

                    <p>
                        Stock:
                        @producto.Stock
                    </p>

                    <a class="btn btn-primary w-100"
                       href="/Carrito/Agregar?productoId=@producto.Id&nombre=@producto.Nombre&precio=@producto.Precio">

                        Agregar al carrito

                    </a>

                </div>

            </div>

        </div>
    }

</div>